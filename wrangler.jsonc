{
  // Media Buyer Control Center — Cloudflare Workers config
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-buyer-control-center",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Static files are bundled into the Worker by scripts/embed-assets.mjs (npm run build)
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbcc-db",
      // Replace with your database id after: npx wrangler d1 create mbcc-db
      "database_id": "ae4a24e5-9be0-4ff3-8a51-188565012fb5",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (never commit them): set with `npx wrangler secret put SETUP_TOKEN` and `npx wrangler secret put VAULT_KEY`
}
